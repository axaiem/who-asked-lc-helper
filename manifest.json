{
  "manifest_version": 3,
  "name": "Who Asked LC Helper",
  "version": "1.0",
  "description": "Show which companies ask a given LeetCode problem.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/problems.json"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
